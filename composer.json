{
    "name": "arca/payment-gateways",
    "description": "Payment gateway integration for Laravel — clean, testable, extensible",
    "keywords": [
        "arca",
        "laravel",
        "payment-gateways",
        "paypal",
        "webpay",
        "getnet",
        "flow",
        "niubiz",
        "mercadopago"
    ],
    "homepage": "https://github.com/elmudometal/payment-gateways",
    "license": "MIT",
    "authors": [
        {
            "name": "Hernan Soto",
            "email": "elmudometal@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/support": "^13.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "dnetix/redirection": "^2.1",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.16",
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-arch": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "phpstan/extension-installer": "^1.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "transbank/transbank-sdk": "^3.0"
    },
    "suggest": {
        "transbank/transbank-sdk": "Required to use the Webpay driver (^3.0)",
        "dnetix/redirection": "Required to use the Getnet driver (^2.1)"
    },
    "autoload": {
        "psr-4": {
            "Arca\\PaymentGateways\\": "src/",
            "Arca\\PaymentGateways\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Arca\\PaymentGateways\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "clear": "@php vendor/bin/testbench package:purge-payment-gateways --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": [
            "@composer run prepare",
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "start": [
            "Composer\\Config::disableProcessTimeout",
            "@composer run build",
            "@php vendor/bin/testbench serve"
        ],
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Arca\\PaymentGateways\\PaymentGatewaysServiceProvider"
            ],
            "aliases": {
                "PaymentGateways": "Arca\\PaymentGateways\\Facades\\PaymentGateways"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
